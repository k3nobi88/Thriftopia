<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Thriftopia" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowAnimationStyle">@style/ThriftopiaActivityAnimation</item>

        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>

        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent_lime</item>
        <item name="colorAccent">@color/accent_lime</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Thriftopia" parent="Base.Theme.Thriftopia" />

    <style name="ThriftopiaActivityAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/thriftopia_fade_zoom_in</item>
        <item name="android:activityOpenExitAnimation">@anim/thriftopia_fade_zoom_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/thriftopia_fade_zoom_in</item>
        <item name="android:activityCloseExitAnimation">@anim/thriftopia_fade_zoom_out</item>
    </style>

</resources>