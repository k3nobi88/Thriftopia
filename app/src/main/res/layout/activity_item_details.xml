<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/text_primary_light"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Item Details"
                    android:textColor="@color/text_primary_light"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnReportListing"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:drawableTop="@drawable/ic_report"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="13dp"
                    android:text=""
                    android:textColor="@color/text_secondary_light" />

            </LinearLayout>

            <ImageView
                android:id="@+id/imgItem"
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_hero"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="ACTIVE"
                android:textColor="@color/accent_lime"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Item Title"
                android:textColor="@color/text_primary_light"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="RM 0.00"
                android:textColor="@color/text_primary_light"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Category • Condition • Size"
                android:textColor="@color/text_secondary_light"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/sellerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seller"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSellerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Loading seller..."
                    android:textColor="@color/text_primary_light"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSellerRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Rating: No ratings yet"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvViewSellerProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="View Seller Profile →"
                    android:textColor="@color/accent_lime"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Description"
                android:textColor="@color/text_primary_light"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:text="No description."
                android:textColor="@color/text_secondary_light"
                android:textSize="15sp" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/fixedActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_light"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/btnViewAuction"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="VIEW AUCTION"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/actionButtonRow"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAddToCart"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_outline_button"
                android:clickable="true"
                android:drawableTop="@drawable/ic_cart"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="12dp"
                android:text=""
                android:textColor="@color/text_primary_light" />

            <TextView
                android:id="@+id/btnBuyNow"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="BUY NOW"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnChatSeller"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_outline_button"
                android:clickable="true"
                android:drawableTop="@drawable/ic_messages"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="12dp"
                android:text=""
                android:textColor="@color/text_primary_light" />

            <TextView
                android:id="@+id/btnWatchlist"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_outline_button"
                android:clickable="true"
                android:drawableTop="@drawable/ic_heart"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="12dp"
                android:text=""
                android:textColor="@color/text_secondary_light" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvUnavailableMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="18dp"
            android:text="This item is unavailable."
            android:textColor="@color/text_secondary_light"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>